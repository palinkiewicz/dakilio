<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Asked for only when the user turns a reminder on (Android 13+), never at startup. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarms don't survive a reboot; the reschedule receiver is only enabled while a reminder is on. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!-- The one reminder alarm. Only the app's own PendingIntent reaches it. -->
        <receiver
            android:name=".ReminderAlarmReceiver"
            android:exported="false" />

        <!-- Sets the alarm again after a reboot, an app update or a clock/time zone change.
             Disabled until a reminder is turned on (ReminderScheduler toggles it). -->
        <receiver
            android:name=".ReminderRescheduleReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
