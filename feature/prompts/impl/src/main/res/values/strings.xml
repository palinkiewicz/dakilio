    <string name="prompts_empty_title">Stuck on a blank page?</string>
    <string name="prompts_empty_body">Add a few questions, and the editor will offer one that fits your mood whenever a note is still empty.</string>
    <string name="prompts_any_mood">Any mood</string>
    <string name="prompts_deleted">Prompt deleted</string>
    <string name="prompts_undo">Undo</string>

    <string name="prompts_sheet_new">New prompt</string>
    <string name="prompts_sheet_edit">Edit prompt</string>
    <string name="prompts_sheet_question">Question</string>
    <string name="prompts_sheet_question_hint">What do you want to ask yourself?</string>
    <string name="prompts_sheet_moods">Offered for</string>
    <string name="prompts_sheet_any_mood">Any mood, and entries without one.</string>
    <string name="prompts_sheet_some_moods">Only entries with one of these moods.</string>
