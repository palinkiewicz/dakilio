<resources>
    <string name="backup_title">Backup &amp; restore</string>
    <string name="backup_subtitle">Your whole journal in one file</string>
    <string name="backup_back">Back</string>

    <string name="backup_home_title">Keep your journal safe</string>
    <string name="backup_home_body">A backup is one .dakilio file with every entry, photo, mood, tag, diary and habit, plus your settings.</string>
    <string name="backup_create_title">Create a backup</string>
    <string name="backup_create_body">Without a password, anyone who has the file can open it and read your entries.</string>
    <string name="backup_create_hint">Keep it somewhere safe, like your computer or a cloud drive, so it survives losing this phone.</string>
    <string name="backup_protect">Protect with a password</string>
    <string name="backup_password">Password</string>
    <string name="backup_password_repeat">Repeat password</string>
    <string name="backup_password_mismatch">The passwords don\'t match</string>
    <string name="backup_password_warning">A forgotten password can\'t be recovered. Without it, nobody can open the backup, not even Dakilio.</string>
    <string name="backup_password_show">Show password</string>
    <string name="backup_password_hide">Hide password</string>
    <string name="backup_create_button">Create backup</string>
    <string name="backup_restore_title">Restore a backup</string>
    <string name="backup_restore_body">Replaces everything in Dakilio with the backup. You\'ll see what\'s inside before anything changes.</string>
    <string name="backup_restore_button">Choose backup</string>
    <string name="backup_privacy">Backups are made and read on this device. Nothing is uploaded.</string>

